VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Firebase Analytics (analytics remains disabled when unset)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional payment provider configuration (server-side provider integration required for live charges)
VITE_PAYMENT_PROVIDER=
VITE_PAYMENT_PUBLIC_KEY=
# Hosted payment page URL (public/payment.html deployed to Netlify/Vercel/static host)
VITE_PAYMENT_WEB_URL=

# Auth redirect allowlist (comma-separated origins). When set, auth redirects
# are restricted to these origins. Leave unset for local/preview.
VITE_ALLOWED_AUTH_ORIGINS=

# Canonical site origin for this deployment. Hosting platforms set this
# automatically at build time (Netlify: URL / DEPLOY_PRIME_URL), so a production
# build locks auth redirects to its own domain with no manual configuration.
# Vercel: VERCEL_PROJECT_PRODUCTION_URL (production) and VERCEL_URL (previews)
# are read automatically as well. Set it explicitly for any other host,
# e.g. https://picu.example.org.np
VITE_SITE_ORIGIN=

# Optional error monitoring. Set exactly one of these; both are off when unset.
# DSN form: https://<public-key>@<host>/<project-id> (Sentry-compatible).
# The key is public by design - it can submit events but never read them.
VITE_ERROR_MONITORING_DSN=
# Or a plain HTTPS endpoint that accepts the JSON report.
VITE_ERROR_MONITORING_ENDPOINT=
